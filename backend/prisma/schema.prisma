// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Quiz {
  id        String     @id @default(uuid())
  title     String
  questions Question[]
}

model Question {
  id       String   @id @default(uuid())
  type     String
  question String
  options  String[]
  quizId   String
  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}
